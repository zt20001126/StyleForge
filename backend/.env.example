APP_NAME=StyleForge Backend
ENVIRONMENT=development
USE_MOCK_AI=true
STORAGE_MODE=memory
FRONTEND_ORIGIN=http://localhost:3000

# Use STORAGE_MODE=postgres with the schema in backend/db/schema.sql for local persistence.
DATABASE_URL=
# Example:
# DATABASE_URL=postgresql+psycopg://styleforge_user:styleforge_password@localhost:55432/styleforge_dev

# Generic AI provider placeholders. Do not commit real keys.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=mock-fashion-trend
AI_TIMEOUT_SECONDS=60

# Logging. Relative LOG_DIR values are resolved under backend/.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Future object storage settings for generated images, videos, and uploads.
# These values match the local MinIO service in ../docker-compose.yml.
# Do not commit real production credentials.
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=styleforge_minio
MINIO_SECRET_KEY=styleforge_minio_password
MINIO_BUCKET=styleforge-assets
MINIO_REGION=us-east-1
MINIO_SECURE=false
