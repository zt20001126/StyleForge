APP_NAME=StyleForge Backend
ENVIRONMENT=development
USE_MOCK_AI=true
STORAGE_MODE=memory
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use STORAGE_MODE=postgres with the schema in backend/db/schema.sql for local persistence.
DATABASE_URL=
# Example:
# DATABASE_URL=postgresql+psycopg://styleforge_user:styleforge_password@localhost:55432/styleforge_dev
REDIS_URL=

# Auth settings. Use a long random secret in shared or production environments.
JWT_SECRET_KEY=styleforge-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SMS_CODE_EXPIRE_MINUTES=5
AUTH_MOCK_SMS_ENABLED=true
AUTH_SMS_PEPPER=styleforge-dev-sms-pepper

# AI provider placeholders. Do not commit real keys.
# Set USE_MOCK_AI=false and AI_PROVIDER=openai|ark|dashscope|anthropic when calling real providers.
AI_PROVIDER=mock
DEFAULT_TEXT_MODEL_PROVIDER=openai
DEFAULT_IMAGE_MODEL_PROVIDER=ark
DEFAULT_VIDEO_MODEL_PROVIDER=ark
AI_TIMEOUT_SECONDS=60

# OpenAI or OpenAI-compatible chat completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Backward-compatible aliases used by older local setups.
AI_API_KEY=
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=mock-fashion-trend

# Volcengine ARK / Seedream / Seedance.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=

# Alibaba Cloud DashScope / Tongyi Wanxiang.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=
DASHSCOPE_IMAGE_MODEL=

# DeepSeek Anthropic-compatible messages API.
# Put real keys only in backend/.env or deployment secrets, never in committed files.
# Example:
# USE_MOCK_AI=false
# AI_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro

# Logging. Relative LOG_DIR values are resolved under backend/.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Object storage settings for generated images, videos, and uploads.
# These values match the local MinIO service in ../docker-compose.yml.
# Do not commit real production credentials.
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=styleforge_minio
MINIO_SECRET_KEY=styleforge_minio_password
MINIO_BUCKET=styleforge-assets
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Alibaba Cloud OSS production-style placeholders.
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
