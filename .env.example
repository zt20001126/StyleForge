# Docker Compose local development settings.
# Copy this file to .env if you need to override the defaults.

MINIO_ROOT_USER=styleforge_minio
MINIO_ROOT_PASSWORD=styleforge_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=styleforge-assets

# Backend logging defaults.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Backend auth defaults.
JWT_SECRET_KEY=styleforge-dev-secret-change-me
AUTH_MOCK_SMS_ENABLED=true
AUTH_SMS_PEPPER=styleforge-dev-sms-pepper
